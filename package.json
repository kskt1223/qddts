{
  "name": "xinzhengyi-water-station",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/*.mjs' --test-coverage-exclude='src/server.mjs' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 tests/*.test.mjs",
    "check": "node --check src/app.mjs && node --check src/server.mjs && node --check public/app.js"
  }
}
